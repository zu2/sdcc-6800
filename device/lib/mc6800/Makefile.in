# libc/mc6800 Makefile

VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

LIB_TYPE     = @LIB_TYPE@

EXTRA_CFLAGS = -mmc6800 --max-allocs-per-node 25000
SAS = $(top_builddir)/bin/sdas6800

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/mc6800

include $(srcdir)/../incl.mk

MC6800_INT =

MC6800_FLOAT = $(COMMON_FLOAT)

MC6800_LONG = $(filter-out _divslong.c _modslong.c _modulong.c,$(COMMON_LONG))

MC6800_LONGLONG = $(COMMON_LONGLONG) \
  _srulonglong.c \
  _srslonglong.c \
  _slulonglong.c \
  _slslonglong.c \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

MC6800_SDCC = $(filter-out _memset.c _memcmp.c _memchr.c,$(COMMON_SDCC)) \
  __itoa.c \
  __ltoa.c \
  _startup.c \
  _strcmp.c \
  strlen.c \
  strnlen.c \
  _strcpy.c \
  div.c \
  ldiv.c \
  memcpy.c \
  _heap.c \
  sprintf.c \
  vprintf.c \
  atomic_flag_clear.c \
  lldiv.c \
  imaxdiv.c

MC6800SOURCES = $(addprefix ../,$(MC6800_FLOAT) $(MC6800_INT) $(MC6800_LONG) $(MC6800_LONGLONG) $(MC6800_SDCC))
MC6800OBJECTS = $(patsubst %.c,%.rel,$(MC6800_FLOAT) $(MC6800_INT) $(MC6800_LONG) $(MC6800_LONGLONG) $(MC6800_SDCC))

OBJ = __sdcc_regs.rel _ret.rel _setjmp.rel atomic_flag_test_and_set.rel _muluchar.rel _mulschar.rel _mulint.rel _mullong.rel _divmodchar.rel _divmodint.rel _divmodlong.rel _mc6800_memcpy.rel _mc6800_memmove.rel _mc6800_memset.rel _mc6800_memcmp.rel _mc6800_memchr.rel

LIB = mc6800.lib
AS = $(SAS)
ASFLAGS = -plosgff

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB) $(PORTDIR)/crt0.rel

$(PORTDIR)/crt0.rel: crt0.rel
	cp crt0.rel $(PORTDIR)/crt0.rel

$(PORTDIR)/$(LIB): $(OBJ) $(MC6800OBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(MC6800OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	rm -f $@
	$(SDAR) -rcSD $@ $(OBJ) $(MC6800OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	rm -f $@
	$(SDAR) -rcD $@ $(OBJ) $(MC6800OBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(MC6800OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(MC6800OBJECTS) $(PORTDIR)
    endif
  endif
endif

%.rel: %.s
	test $(srcdir) = . || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test $(srcdir) = . || rm $(notdir $<)

%.rel: %.c
	$(CC) $(CFLAGS) ${EXTRA_CFLAGS} -c $<

%.rel: ../%.c
	$(CC) $(CFLAGS) ${EXTRA_CFLAGS} -c $<

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/mc6800/Makefile
