# libc/mc6800 Makefile

srcdir = @srcdir@
top_srcdir = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

PORT ?= mc6800
MODELFLAGS ?= -mmc6800
VPATH = $(srcdir):$(std_lib_dirs)
AS = $(top_builddir)/bin/sdas6800
EXTRA_CFLAGS = --max-allocs-per-node 25000
PORT_CRT = crt0.rel
LIB = mc6800.lib

LIB_TYPE = @LIB_TYPE@

PORT_SDCC = $(filter-out _divmixchar _divschar _divuchar _modmixchar _modschar _moduchar \
  _divsint _divuint _modsint _moduint _divslong _divulong _modslong _modulong,$(COMMON_SDCC)) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  __sdcc_regs \
  _divmodchar \
  _divmodint \
  _divmodlong \
  _mulschar \
  _muluchar \
  _ret

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(filter-out memchr memcmp memmove memset strcat strchr strcmp strcpy \
  strlen strncat strncmp strncpy strrchr strstr strtok setjmp,$(COMMON_LIBC)) \
  $(COMMON_LIBC_STRUCT_RET) \
  _mc6800_memchr \
  _mc6800_memcmp \
  _mc6800_memcpy \
  _mc6800_memmove \
  _mc6800_memset \
  _mc6800_strcat \
  _mc6800_strchr \
  _mc6800_strcmp \
  _mc6800_strcpy \
  _mc6800_strlen \
  _mc6800_strncat \
  _mc6800_strncmp \
  _mc6800_strncpy \
  _mc6800_strrchr \
  _mc6800_strstr \
  _mc6800_strtok \
  _setjmp \
  atomic_flag_clear \
  atomic_flag_test_and_set

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk
