# libc/mc6800 Makefile

VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

LIB_TYPE     = @LIB_TYPE@

EXTRA_CFLAGS = -mmc6800 --stack-auto --max-allocs-per-node 25000
SAS = $(top_builddir)/bin/sdas6800

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/mc6800-stack-auto

include $(srcdir)/../incl.mk

MC6800_FLOAT = $(COMMON_FLOAT)

MC6800_INT = $(COMMON_INT) \
  _mulint.c \
  _divsint.c \
  _divuint.c \
  _modsint.c \
  _moduint.c

MC6800_LONG = $(COMMON_LONG) \
  _mullong.c \
  _divulong.c

MC6800_LONGLONG = $(COMMON_LONGLONG) \
  _srulonglong.c \
  _srslonglong.c \
  _slulonglong.c \
  _slslonglong.c \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

MC6800_SDCC = $(COMMON_SDCC) \
  __itoa.c \
  __ltoa.c \
  _spx.c \
  _startup.c \
  strlen.c \
  strnlen.c \
  _strcmp.c \
  _strcpy.c \
  __memcpy.c \
  div.c \
  ldiv.c \
  memcpy.c \
  _memmove.c \
  _heap.c \
  sprintf.c \
  vprintf.c \
  atomic_flag_clear.c

MC6800SOURCES = $(addprefix ../,$(MC6800_FLOAT) $(MC6800_INT) $(MC6800_LONG) $(MC6800_LONGLONG) $(MC6800_SDCC))
MC6800OBJECTS = $(patsubst %.c,%.rel,$(MC6800_FLOAT) $(MC6800_INT) $(MC6800_LONG) $(MC6800_LONGLONG) $(MC6800_SDCC))

OBJ = _ret.rel _setjmp.rel atomic_flag_test_and_set.rel

LIB = s08.lib
AS = $(SAS)
ASFLAGS = -plosgff

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB)

$(PORTDIR)/$(LIB): $(OBJ) $(MC6800OBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(MC6800OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(MC6800OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(MC6800OBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(MC6800OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(MC6800OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/s08-stack-auto/Makefile
