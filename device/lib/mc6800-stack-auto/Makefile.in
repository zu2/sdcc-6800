# libc/mc6800-stack-auto Makefile

srcdir = @srcdir@
top_srcdir = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

PORT ?= mc6800-stack-auto
MODELFLAGS ?= -mmc6800 --stack-auto
VPATH = $(std_lib_dirs)
AS = $(top_builddir)/bin/sdas6800
EXTRA_CFLAGS = --max-allocs-per-node 25000
PORT_CRT = crt0.rel
LIB = mc6800.lib

# Keep the configured library type when library_build.mk sets its debug default.
LIB_TYPE = @LIB_TYPE@
override LIB_TYPE := $(LIB_TYPE)

PORT_SDCC = $(filter-out _divslong _divulong _modslong _modulong,$(COMMON_SDCC)) \
  __sdcc_regs \
  _divmodchar \
  _divmodint \
  _divmodlong \
  _divslonglong \
  _divulonglong \
  _modslonglong \
  _modulonglong \
  _mulint \
  _mullonglong \
  _mulschar \
  _muluchar \
  _ret \
  _slslonglong \
  _slulonglong \
  _srslonglong \
  _srulonglong \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(filter-out memchr memcmp memmove memset strcat strchr strcmp strcpy \
  strlen strncat strncmp strncpy strrchr strstr strtok,$(COMMON_LIBC)) \
  __itoa \
  __ltoa \
  _heap \
  _mc6800_memchr \
  _mc6800_memcmp \
  _mc6800_memcpy \
  _mc6800_memmove \
  _mc6800_memset \
  _mc6800_strcat \
  _mc6800_strchr \
  _mc6800_strcmp \
  _mc6800_strcpy \
  _mc6800_strlen \
  _mc6800_strncat \
  _mc6800_strncmp \
  _mc6800_strncpy \
  _mc6800_strrchr \
  _mc6800_strstr \
  _mc6800_strtok \
  _setjmp \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  div \
  imaxdiv \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk
